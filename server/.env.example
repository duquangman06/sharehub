# Local: a running MongoDB replica set; cloud: your Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/sharehub?replicaSet=rs0
SESSION_SECRET=replace-with-a-long-random-secret
# Set production in Vercel dashboard.
NODE_ENV=development
# Use Atlas GridFS for durable file uploads on Vercel.
UPLOAD_STORAGE=mongodb

# Optional: Gemini key on the SERVER only. Vercel AI Gateway also accepts
# AI_GATEWAY_API_KEY or the deployment's automatically supplied OIDC token.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# AI_GATEWAY_MODEL=google/gemini-2.5-flash-lite
